[alias]
  pull-request = "!glab mr create --assignee=caleb.hearth --fill --yes --fill-commit-body --squash-before-merge --remove-source-branch"

[mailmap]
  file = "~/.dotfiles/files-com/mailmap"

[merge]
  ff = true

[diff "terraform"]
  xfuncname = "^[[:space:]]*((resource|data|variable|output|module|locals|provider|terraform)[[:space:]].*[{]|\"[^\"]+\"[[:space:]]*:)"

[filter "tofu"]
  clean = tofu fmt -
  smudge = cat

[user]
  email = caleb.hearth@files.com
